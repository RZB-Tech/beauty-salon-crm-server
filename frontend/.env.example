# Backend base URL. Empty = same origin: serve the mini app from a domain whose nginx
# proxies /api/v1 to the backend (no CORS needed). If you point it at another domain
# (e.g. https://api.osipovich.uz), set TELEGRAM_MINIAPP_ORIGIN on the backend to this
# mini app's origin so CORS allows it.
VITE_API_BASE_URL=

# Path the app is served under. "/" on its own (sub)domain; "/miniapp/" to serve it
# under an existing domain, e.g. https://crm.osipovich.uz/miniapp/ (trailing slash required)
VITE_BASE_PATH=/

# `npm run dev` only: where /api is proxied to
VITE_DEV_PROXY_TARGET=http://localhost:8000
